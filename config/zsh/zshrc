# NVM Setup
# The default version's bin goes on PATH directly; nvm.sh and its completion
# load on the first `nvm` call. A default alias that is not a plain version
# directory (lts/*, node, stable) has no bin path to prepend, so nvm.sh is
# sourced up front instead and resolves the alias itself.
export NVM_DIR="$HOME/.nvm"
_nvm_pinned=0
if [[ -r "$NVM_DIR/alias/default" ]]; then
    read -r _nvm_default < "$NVM_DIR/alias/default"
    if [[ -d "$NVM_DIR/versions/node/v$_nvm_default/bin" ]]; then
        path=("$NVM_DIR/versions/node/v$_nvm_default/bin" $path)
        _nvm_pinned=1
    fi
fi
if (( _nvm_pinned )); then
    nvm() {
        unset -f nvm
        \. "$NVM_DIR/nvm.sh"
        [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
        nvm "$@"
    }
else
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
fi
unset _nvm_default _nvm_pinned

